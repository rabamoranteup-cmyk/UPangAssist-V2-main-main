# Google OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=1051449094735-rqh9j340r8qbdp10h5v7rn880696mbbv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Add this exact URL to the OAuth client's Authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# The existing email policy must include phinmaed.com.
ALLOWED_EMAIL_DOMAINS=phinmaed.com
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=your-mongodb-atlas-connection-string
# Optional comma-separated DNS server IPs for resolving mongodb+srv URIs.
# Leave unset in deployments that should use the platform's default DNS resolvers.
MONGODB_DNS_SERVERS=
